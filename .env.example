# Local development environment: copy to .env (git ignores it) and change what you need.
#   cp .env.example .env
# compose.yaml takes every port and password from here. These values are for a local machine only;
# real stands get their own secrets (see docs/ARCHITECTURE.md).

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform-dev
POSTGRES_DB=platform

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=platform-dev

# RabbitMQ (AMQP and the management UI)
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=platform
RABBITMQ_PASSWORD=platform-dev

# OpenSearch (locally without the security plugin: no TLS, no password)
OPENSEARCH_PORT=9200

# MinIO: S3 API and the web console; the password needs at least 8 characters
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=platform
MINIO_ROOT_PASSWORD=platform-dev

# imgproxy: signing key and salt, hex
IMGPROXY_PORT=8081
IMGPROXY_KEY=943b421c9eb07c830af81030552c86009268de4e532ba2ee2eab8247c6da0881
IMGPROXY_SALT=520f986b998545b4785e0defbb4f3c1df7a0c45ca7a5ab3c1f80bd0ef2d46dc4

# Mailpit: SMTP for the application and the web UI with the caught mail
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ClickHouse: HTTP and native protocol
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=19000
CLICKHOUSE_USER=platform
CLICKHOUSE_PASSWORD=platform-dev
CLICKHOUSE_DB=platform
