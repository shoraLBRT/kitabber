# Template of the env file of the stage stand (E01-03). The deploy workflow writes the real file from the GitHub
# environment `stage` (variables and secrets, see docs/DEPLOY.md); locally copy it and fill the values in.
# Values here are placeholders, never real passwords.
IMAGE_REGISTRY=ghcr.io/owner/kitabber
IMAGE_TAG=latest
SITE_ADDRESS=stage.example.org
ADMIN_ADDRESS=admin.stage.example.org
# The site with its scheme: the issuer of the OpenID Connect provider (the deploy workflow derives it from SITE_ADDRESS)
SITE_URL=https://stage.example.org
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
# Mail service of the stand (SMTP, ADR-0017): port 587 with StartTls or 465 with SslOnConnect
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=noreply@example.org
SMTP_PASSWORD=change-me
MAIL_FROM=noreply@example.org
# Sign-in (ADR-0018, docs/CONFIG.md): the provider's RSA signing key (base64 DER), its AES-256 key (base64 of 32 bytes)
# and the key of the site's session cookies (at least 32 characters)
IDENTITY_SIGNING_KEY=change-me
IDENTITY_ENCRYPTION_KEY=change-me
SESSION_PASSWORD=change-me
# S3 bucket of media (ADR-0030, docs/CONFIG.md): any S3-compatible service; the bucket is created by the owner
MEDIA_S3_URL=https://s3.example.org
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=kitabber-stage-media
MEDIA_S3_ACCESS_KEY=change-me
MEDIA_S3_SECRET_KEY=change-me
