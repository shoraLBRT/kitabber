# Template of the env file of the stage stand (E01-03). The deploy workflow writes the real file from the GitHub
# environment `stage` (variables and secrets, see docs/DEPLOY.md); locally copy it and fill the values in.
# Values here are placeholders, never real passwords.
IMAGE_REGISTRY=ghcr.io/owner/kitabber
IMAGE_TAG=latest
SITE_ADDRESS=stage.example.org
ADMIN_ADDRESS=admin.stage.example.org
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
