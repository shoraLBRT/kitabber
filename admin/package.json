{
  "name": "platform-admin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "lint": "eslint . && stylelint --allow-empty-input \"**/*.{css,vue}\" && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "typecheck": "vue-tsc --build",
    "test": "vitest run --reporter=dot"
  },
  "dependencies": {
    "lucide-vue-next": "1.0.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.7",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.6.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "happy-dom": "21.0.4",
    "postcss-html": "2.0.0",
    "prettier": "3.10.1",
    "stylelint": "17.16.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
