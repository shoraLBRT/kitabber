{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>shoraLBRT/habze//renovate/default#v1"],
  "customManagers": [
    {
      "description": "gitleaks for the secret scan is installed by version in ci.yml, not by a package manager (#285).",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+GITLEAKS_VERSION:\\s*(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "MassTransit 9+ has a commercial licence; stay on Apache-2.0 8.x (ADR-0005).",
      "matchPackageNames": ["/^MassTransit/"],
      "allowedVersions": "<9"
    }
  ]
}
