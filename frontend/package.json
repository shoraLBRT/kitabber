{
  "name": "platform-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . && stylelint --allow-empty-input \"**/*.{css,vue}\" && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --reporter=dot --reporter=junit --outputFile.junit=../artifacts/test-results/frontend/junit.xml",
    "e2e": "playwright test",
    "api:generate": "openapi-typescript ../backend/src/Api/openapi/v1.json -o api/schema.d.ts"
  },
  "dependencies": {
    "@editorjs/editorjs": "2.31.7",
    "@microsoft/signalr": "10.0.11",
    "ioredis": "5.11.1",
    "lucide-vue-next": "1.0.0",
    "nuxt": "3.21.11",
    "openapi-fetch": "0.17.0",
    "openid-client": "6.8.8",
    "unstorage": "1.17.6",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "happy-dom": "21.0.4",
    "openapi-typescript": "7.13.0",
    "postcss-html": "2.0.0",
    "prettier": "3.10.1",
    "stylelint": "17.16.0",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
