// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PostBlocks: a snapshot of each block type > Arabic and mixed Russian and Arabic text 1`] = `
"<div class="post-blocks" data-testid="post-blocks">
<p class="post-blocks__text" dir="auto">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ، قال: «Привет»!</p>
<p class="post-blocks__text" dir="auto">Он сказал: «<b>[السلام</b> عليكم]», и повторил 3 раза.</p>
<h2 id="h-r3" class="post-blocks__heading post-blocks__heading--h2" dir="auto">Глава «[كتاب]»</h2>
<ul class="post-list" dir="auto">
<li class="post-list__item">
<span>واحد</span>
</li>
<li class="post-list__item">
<span>Два: [اثنان].</span>
</li>
</ul>
<figure class="post-blocks__quote" dir="auto">
<blockquote class="post-blocks__quote-text">
<p>العلم نور</p>
</blockquote>
<figcaption class="post-blocks__quote-caption" dir="auto">Пословица, «[مثل]»</figcaption>
</figure>
</div>"
`;

exports[`PostBlocks: a snapshot of each block type > bulleted and numbered lists with nesting 1`] = `
"<div class="post-blocks" data-testid="post-blocks">
<ul class="post-list" dir="auto">
<li class="post-list__item">
<span>Раз</span>
</li>
<li class="post-list__item">
<span>Два</span>
</li>
</ul>
<ol class="post-list" dir="auto">
<li class="post-list__item">
<span>Первый</span>
<ol class="post-list post-list--nested" dir="auto">
<li class="post-list__item">
<span>
<b>Вложенный</b>
</span>
</li>
</ol>
</li>
<li class="post-list__item">
<span>Второй</span>
</li>
</ol>
</div>"
`;

