        <IsTestProject>true</IsTestProject>
        <RootNamespace>Platform.Messaging.IntegrationTests</RootNamespace>
        <!-- Run through VSTest, like Platform.Persistence.IntegrationTests: verify.ps1 uses the TRX logger. -->
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
