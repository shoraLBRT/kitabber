<Project>
    <!-- Central package management: versions are set here, projects reference packages without a version. -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    </ItemGroup>

    <!-- Database: EF Core on PostgreSQL, a schema per module (ADR-0004). -->
    <ItemGroup>
        <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    </ItemGroup>

    <!-- Messaging and cache: MassTransit on RabbitMQ with the EF Core outbox, Redis (ADR-0005).
         MassTransit stays on 8.x: it is Apache-2.0, from 9.0 the licence is commercial. -->
    <ItemGroup>
        <PackageVersion Include="MassTransit" Version="8.5.12" />
        <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="8.5.12" />
        <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.12" />
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    </ItemGroup>

    <!-- Tests -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
        <PackageVersion Include="Testcontainers.RabbitMq" Version="4.17.0" />
        <PackageVersion Include="Testcontainers.Redis" Version="4.17.0" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageVersion Include="xunit.v3" Version="4.0.3" />
    </ItemGroup>
</Project>
