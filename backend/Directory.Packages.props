<Project>
    <!-- Central package management: versions are set here, projects reference packages without a version. -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    </ItemGroup>

    <!-- Database: EF Core on PostgreSQL, a schema per module (ADR-0004). -->
    <ItemGroup>
        <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    </ItemGroup>

    <!-- Messaging and cache: MassTransit on RabbitMQ with the EF Core outbox, Redis (ADR-0005).
         MassTransit stays on 8.x: it is Apache-2.0, from 9.0 the licence is commercial. -->
    <ItemGroup>
        <PackageVersion Include="MailKit" Version="4.18.2" />
        <PackageVersion Include="MassTransit" Version="8.5.12" />
        <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="8.5.12" />
        <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.12" />
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    </ItemGroup>

    <!-- REST API: problem details, validation and OpenAPI come from ASP.NET Core; ApiDescription.Server also
         writes the OpenAPI document at build time (ADR-0006). -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15" />
    </ItemGroup>

    <!-- Observability: OpenTelemetry traces, metrics and logs, OTLP to a collector, Prometheus scrape endpoint on the
         API, health checks (ADR-0015). The Prometheus exporter is published only as beta. -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.15" />
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.21.0-beta.1" />
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    </ItemGroup>

    <!-- Sign-in: Identity is an OpenID Connect provider on OpenIddict (Apache-2.0); the API validates its tokens with
         OpenIddict validation (ADR-0002, ADR-0018). -->
    <ItemGroup>
        <PackageVersion Include="OpenIddict.AspNetCore" Version="7.9.0" />
        <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.9.0" />
    </ItemGroup>

    <!-- Tests: xUnit v3 through VSTest, Testcontainers, Respawn and a fake clock (ADR-0008). -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageVersion Include="Respawn" Version="7.0.0" />
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
        <PackageVersion Include="Testcontainers.RabbitMq" Version="4.17.0" />
        <PackageVersion Include="Testcontainers.Redis" Version="4.17.0" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageVersion Include="xunit.v3" Version="4.0.3" />
        <PackageVersion Include="xunit.v3.assert" Version="4.0.3" />
        <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
    </ItemGroup>
</Project>
