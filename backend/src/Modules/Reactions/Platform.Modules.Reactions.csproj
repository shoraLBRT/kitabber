<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The Reactions module (FR-REACT, ADR-0061): likes on posts and comments, and later the set of reactions, the list
      of those who reacted and the rating. Its tables live in the schema `reactions`; it knows the person only by the
      account_id (FR-ID-1) and asks about a post or a comment through Posts.Contracts and Comments.Contracts.
    -->
    <PropertyGroup>
        <RootNamespace>Platform.Modules.Reactions</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../Http/Platform.Http.csproj" />
        <ProjectReference Include="../../Messaging/Platform.Messaging.csproj" />
        <ProjectReference Include="../../Persistence/Platform.Persistence.csproj" />
        <ProjectReference Include="../Comments.Contracts/Platform.Modules.Comments.Contracts.csproj" />
        <ProjectReference Include="../Identity.Contracts/Platform.Modules.Identity.Contracts.csproj" />
        <ProjectReference Include="../Posts.Contracts/Platform.Modules.Posts.Contracts.csproj" />
        <ProjectReference Include="../Reactions.Contracts/Platform.Modules.Reactions.Contracts.csproj" />
        <ProjectReference Include="../../Realtime/Platform.Realtime.csproj" />
    </ItemGroup>

</Project>
