<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The Media module (FR-MEDIA, ADR-0030): accepting uploaded files, checking their type by content and their size,
      keeping the original in the object storage under an unpredictable key. Its tables live in the schema `media`;
      it knows the owner only by the account_id (FR-ID-1). The storage is behind IObjectStorage: S3 (MinIO locally)
      or the in-memory fake for tests.
    -->
    <PropertyGroup>
        <RootNamespace>Platform.Modules.Media</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../Http/Platform.Http.csproj" />
        <ProjectReference Include="../../Persistence/Platform.Persistence.csproj" />
        <ProjectReference Include="../../Configuration/Platform.Configuration.csproj" />
    </ItemGroup>

</Project>
