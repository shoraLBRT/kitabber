<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The Blogs module (FR-PROFILE, ADR-0025): the Subsite, one entity for a person's blog and for a topic, and the
      profile API. Its tables live in the schema `blogs`; it knows an account only by its account_id (FR-ID-1) and
      learns about new accounts from the Identity event AccountActivated.
    -->
    <PropertyGroup>
        <RootNamespace>Platform.Modules.Blogs</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../Http/Platform.Http.csproj" />
        <ProjectReference Include="../../Messaging/Platform.Messaging.csproj" />
        <ProjectReference Include="../../Persistence/Platform.Persistence.csproj" />
        <ProjectReference Include="../../Seeding/Platform.Seeding.csproj" />
        <ProjectReference Include="../../Configuration/Platform.Configuration.csproj" />
        <ProjectReference Include="../Identity.Contracts/Platform.Modules.Identity.Contracts.csproj" />
    </ItemGroup>

</Project>
