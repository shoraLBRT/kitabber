<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The Identity module (ADR-0002, docs/unified-accounts.md): the account and everything that signs it in. Its
      tables live in the schema `identity`; other modules know an account only by its account_id. Identity is the
      OpenID Connect provider of the platform (OpenIddict, ADR-0018) and validates the tokens the API receives.
    -->
    <PropertyGroup>
        <RootNamespace>Platform.Modules.Identity</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="OpenIddict.AspNetCore" />
        <PackageReference Include="OpenIddict.EntityFrameworkCore" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../Configuration/Platform.Configuration.csproj" />
        <ProjectReference Include="../../Persistence/Platform.Persistence.csproj" />
        <ProjectReference Include="../../Seeding/Platform.Seeding.csproj" />
    </ItemGroup>

</Project>
