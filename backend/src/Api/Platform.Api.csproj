<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <RootNamespace>Platform.Api</RootNamespace>
        <!-- The OpenAPI document is written on every build into obj/openapi; the test
             Platform.Api.Tests compares it with the committed snapshot openapi/v1.json (ADR-0006). -->
        <OpenApiDocumentsDirectory>$(BaseIntermediateOutputPath)openapi</OpenApiDocumentsDirectory>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Configuration/Platform.Configuration.csproj" />
        <ProjectReference Include="../Http/Platform.Http.csproj" />
        <ProjectReference Include="../Messaging/Platform.Messaging.csproj" />
        <ProjectReference Include="../Modules/Blogs/Platform.Modules.Blogs.csproj" />
        <ProjectReference Include="../Modules/Comments/Platform.Modules.Comments.csproj" />
        <ProjectReference Include="../Modules/Notifications/Platform.Modules.Notifications.csproj" />
        <ProjectReference Include="../Modules/Preferences/Platform.Modules.Preferences.csproj" />
        <ProjectReference Include="../Modules/Reactions/Platform.Modules.Reactions.csproj" />
        <ProjectReference Include="../Modules/Media/Platform.Modules.Media.csproj" />
        <ProjectReference Include="../Modules/Editor/Platform.Modules.Editor.csproj" />
        <ProjectReference Include="../Modules/Identity/Platform.Modules.Identity.csproj" />
        <ProjectReference Include="../Modules/Posts/Platform.Modules.Posts.csproj" />
        <ProjectReference Include="../Observability/Platform.Observability.csproj" />
        <ProjectReference Include="../Realtime/Platform.Realtime.csproj" />
    </ItemGroup>

</Project>
